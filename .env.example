# Development HTTP server (no secrets in Git)
HOST=127.0.0.1
PORT=8787
NOGITA_ADMIN_TOKEN=replace-with-long-random-local-token
# Local runtime state; contains only hashed event IDs/bindings, never messages, transcripts, or credentials.
NOGITA_STATE_DIR=.nogita-state
# Set true after mounting a persistent disk and pointing the state directory inside it (absolute path). Required on
# Render and for a company cell (NOGITA_TENANT_CONFIG): without it the cell does not start. The directory is marked
# with the company it belongs to, and one company's cell refuses another's directory.
NOGITA_STATE_PERSISTENT=false
# Require persistent storage for a .env setup too.
NOGITA_REQUIRE_PERSISTENT_STATE=false
# Generate 32 random bytes, encode as base64, and keep this value stable in deployment secrets.
NOGITA_QUEUE_ENCRYPTION_KEY=
# Verified human IDs permitted to retrieve code and create tasks; comma separated
AUTHORIZED_ACTOR_IDS=demo-lead
# Compact JSON array linking trusted provider IDs to one internal ID.
# Keep real identifiers in local .env; see config/identities.example.json.
IDENTITY_MAP_JSON=[]

# One company's boards, repositories, chat, people and AI settings as a JSON file (see config/tenant.example.json).
# It can hold several boards and repositories; secrets in it are "env:NAME" references to variables here.
# When set, it replaces NOGITA_MODE, BOARD_PROVIDER, JIRA_*, MONDAY_*, REPO_PROVIDER, GITHUB_*, SLACK_BOT_TOKEN,
# SLACK_USER_TOKEN, IDENTITY_MAP_JSON, AUTHORIZED_ACTOR_IDS and the ANTHROPIC_* model settings in this file.
NOGITA_TENANT_CONFIG=
# Mode: demo (dependency-free and safe) or live (requires real credentials)
NOGITA_MODE=demo
BOARD_PROVIDER=demo
REPO_PROVIDER=demo
MEETING_PROVIDER=demo

# Jira Cloud (BOARD_PROVIDER=jira): per-project settings, no guessed assignees
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Jira account ID for the optional assignee, NEVER a guessed display name
JIRA_ASSIGNEE_ACCOUNT_ID=

# monday.com (BOARD_PROVIDER=monday)
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# A valid Text column ID on that board; required to preserve issue descriptions
MONDAY_DESCRIPTION_COLUMN_ID=

# GitHub (REPO_PROVIDER=github)
# Public repositories can be read without a token only when this explicit gate is true.
GITHUB_PUBLIC_REPO=false
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_REF=main
# "Nogita, open a draft PR for ...": a new branch from GITHUB_REF with one note file and a draft pull request.
# Never merges or writes to an existing branch. Needs GITHUB_TOKEN with Contents and Pull requests write. Off unless true.
GITHUB_DRAFT_PRS=false

# Recall.ai meeting bot (MEETING_PROVIDER=recall)
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Voice is NOT yet connected. Recall join/chat works once configured.

# Attendee.dev (MEETING_PROVIDER=attendee). Do not enable before provider privacy review.
ATTENDEE_API_KEY=
ATTENDEE_PRIVACY_REVIEWED=false
ATTENDEE_WEBHOOK_URL=https://your-service.example/webhooks/attendee
# Base64-encoded project webhook secret from Attendee Settings > Webhooks.
ATTENDEE_WEBHOOK_SECRET=
# Used only for the local per-session cost estimate. Update if your Attendee plan has a different rate.
ATTENDEE_USD_PER_HOUR=0.50
# Signed transcript ingestion and stable Attendee identity mapping are supported.
# Realtime media is experimental and off by default; enable only after WSS,
# consent/privacy review, and a planned test meeting. The first TTS model is English-only.
NOGITA_REALTIME_AUDIO_ENABLED=false
# Measured 80 ms pause/classify turn-taking profile. Keep false until lab false-pause acceptance passes.
NOGITA_TURN_TAKING_V2=false
# Without her name, a mixed or fragmentary transcript (two voices on one mic, chatter caught mid-sentence), a
# question for the room ("did anyone...?") or a remark that asks nothing gets no spoken reply. Off by default.
NOGITA_ROOM_NOISE_GUARD=
# Her name came through but the question did not (lost in crosstalk): she asks "did someone ask me something?"
# within seconds, and the lost words are not answered later. Off by default.
NOGITA_SWALLOWED_QUESTION=
# Two-speed answers: a spoken research question ("what landed today?") gets a short line at once, goes on as a mission
# in the background, and the full answer is spoken when the room is quiet, or stays in chat. Off by default.
NOGITA_TWO_SPEED=
# "What's left of what I asked?": mission_status answers from the mission store what was done, what failed and what
# is still open, with its sources. Off by default.
NOGITA_MISSION_STATUS=
ATTENDEE_AUDIO_WEBSOCKET_URL=wss://your-service.example/webhooks/attendee/audio
DEEPGRAM_API_KEY=
# Keep meeting audio, transcripts and synthesized speech out of Deepgram model improvement (recommended).
DEEPGRAM_MIP_OPT_OUT=true
# Empty: flux-english for English-only meetings (faster turns, early starts), nova3-multilingual otherwise.
# flux-english is refused (flux_disabled_language_unsupported in the log) while NOGITA_LANGUAGES includes anything but en.
DEEPGRAM_STT_MODE=
# Languages people speak in meetings (two-letter codes; default en). Hints for Nova-3 multilingual.
NOGITA_LANGUAGES=
# Per-turn diagnostics in NOGITA_STATE_DIR/turns (npm run turn-report). redacted (default): timings, statuses,
# word counts and hashed speakers, no words. full: adds words and names, for consented test meetings only. off.
NOGITA_TURN_LOG=
# Delegated missions report progress in the meeting or thread they came from; once that has ended, here (a Slack
# channel id the bot can post in). Unset: the dashboard (GET /missions) and `npm run mission -- list` only.
NOGITA_MISSION_CHANNEL=
# flux-english only: how sure Deepgram must be that a person finished before Nogita answers (default 0.8).
# 0.7 (Deepgram's default) ended turns at the pause after "Nogita," in the voice lab.
DEEPGRAM_EOT_THRESHOLD=
# flux-english only: Nogita starts working on a question at Deepgram's early end-of-turn (default 0.5) and speaks
# only once the turn is confirmed with the same words; "off" waits for the confirmed end of turn.
DEEPGRAM_EAGER_EOT_THRESHOLD=
# Experimental hold for incomplete addressed requests, 0 (off) to 5000 milliseconds.
NOGITA_INCOMPLETE_TURN_HOLD_MS=0
# Experimental: a complete question to her ends the turn after this much own-voice silence past Flux's early
# end-of-turn, instead of waiting for the confirmed one (noise delayed it 1-2.7 s in the lab). 0 (off) to 1000 ms.
NOGITA_EARLY_COMMIT_MS=0
# English Aura-2 voice; change only after a consented listening comparison.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Update these local cost-estimate rates to match the active Deepgram plan.
DEEPGRAM_NOVA3_MULTILINGUAL_USD_PER_MINUTE=0.0058
DEEPGRAM_AURA2_USD_PER_THOUSAND_CHARACTERS=0.03

# Optional Anthropic reasoning for live text plans. ANTHROPIC_MODEL defaults to
# claude-haiku-5-5; override it only when intentionally choosing another model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_USD_PER_MILLION=0.10
ANTHROPIC_OUTPUT_USD_PER_MILLION=0.50
# Optional: a stronger model for multi-file why/architecture questions. Disabled when blank.
# At most 3 such calls per meeting by default; simple questions stay on ANTHROPIC_MODEL.
# Set prices to the actual model/account rates for usage estimates.
ANTHROPIC_CODE_REASONING_MODEL=
ANTHROPIC_CODE_INPUT_USD_PER_MILLION=3
ANTHROPIC_CODE_OUTPUT_USD_PER_MILLION=15
ANTHROPIC_MAX_CODE_REASONING_CALLS_PER_SESSION=3
# Conversational agent (live mode): answers every direct request with tools over GitHub, Jira and Slack,
# streams speech sentence by sentence and caches the prompt. NOGITA_AGENT=off falls back to the
# one-shot planner above. ANTHROPIC_AGENT_MODEL defaults to claude-haiku-5-5: in the voice lab it spoke its own
# words about 1.3 s sooner than claude-sonnet-5-5 with equal judged correctness. Use claude-sonnet-5-5
# (input 2, output 10 USD per million) for deeper code answers at higher latency.
NOGITA_AGENT=
ANTHROPIC_AGENT_MODEL=
ANTHROPIC_AGENT_INPUT_USD_PER_MILLION=0.10
ANTHROPIC_AGENT_OUTPUT_USD_PER_MILLION=0.50
# The agent answers without thinking first (half the time to first word on Haiku, same quality in the voice
# lab). Set to "on" to let it think before answering.
ANTHROPIC_AGENT_THINKING=
# Speech recognition: flux-english was faster and more accurate than nova3-multilingual in every voice lab run.
# Extra Jira project keys the agent may read (comma-separated). Tasks are still created in JIRA_PROJECT_KEY.
JIRA_READ_PROJECT_KEYS=
# Nogita's presence screen (Attendee): a silent page that shows whether she is listening, thinking or speaking.
# camera (default) shows it as her webcam tile; screenshare shares it as a screen instead; off disables it.
NOGITA_PRESENCE=
# Public HTTPS origin of this service for the page (defaults to the origin of ATTENDEE_WEBHOOK_URL).
NOGITA_PUBLIC_URL=
# Where the platform has no native hand raise (Attendee today): 'chat' posts a short
# "Nogita has something to add" line; blank keeps the hand silent.
NOGITA_HAND_RAISE_FALLBACK=
# 'true': when she leaves, one meeting-chat line lists the action items nobody took ("we need to..." with no owner).
# Off by default. Asking "Nogita, what's still open?" works either way.
NOGITA_ACTION_ITEM_RECAP=
# Phase 3 research, each 'true' or blank (off). They apply to every agent turn, in chat and in voice.
# ci_status tool: CI runs for a branch, commit or PR, and which commit is deployed (GitHub only).
NOGITA_CI_STATUS=
# A large tool result reaches the model as a digest (counts, groups, top items) it can page through, instead of a cut.
NOGITA_RESULT_DIGEST=
# Every tool result is recorded as a source; chat answers cite them and end with the links. Nothing extra is spoken.
NOGITA_EVIDENCE_LEDGER=
# Say how far something got (planned, in code, tested, ... in production); "works in production" only with a
# deployment to show. Checking the chat answer needs NOGITA_EVIDENCE_LEDGER too.
NOGITA_PROOF_LEVELS=
# Recurring research questions (what changed today or this week, feature status, why it broke, open tasks, version
# diff) get a short plan of which sources to read and what the answer must cover.
NOGITA_RESEARCH_TEMPLATES=
# 'decisions': keep each meeting's plainly stated decisions and action items (never the transcript or audio) under
# NOGITA_STATE_DIR/meetings, so "what did we decide last week about X?" works. Off by default; review privacy first.
NOGITA_MEETING_MEMORY=
NOGITA_MEETING_MEMORY_DAYS=90

# Slack signed Events API, if used
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Agent access to Slack needs bot scopes channels:read, groups:read, channels:history,
# groups:history, im:history, users:read and chat:write, plus the message.channels and
# message.groups events so replies in a thread Nogita is in reach her without a mention.
# Optional user token (xoxp-, search:read) enables message search across her channels.
SLACK_USER_TOKEN=

# Slack Socket Mode: create app-level token (connections:write) and bot token.
SLACK_APP_TOKEN=
SLACK_ALLOWED_TEAM_IDS=
# AUTHORIZED_ACTOR_IDS must include mapped internal IDs from IDENTITY_MAP_JSON.

# Keep receipts of writes on disk so a retried event after a restart is not written twice.
NOGITA_DURABLE_RECEIPTS=
