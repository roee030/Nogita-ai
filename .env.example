# Development HTTP server (no secrets in Git)
HOST=127.0.0.1
PORT=8787
NOGITA_ADMIN_TOKEN=replace-with-long-random-local-token
# Local runtime state; contains only hashed event IDs/bindings, never messages, transcripts, or credentials.
NOGITA_STATE_DIR=.nogita-state
# Render only: set true after mounting a persistent disk and pointing the state directory inside it.
NOGITA_STATE_PERSISTENT=false
# Generate 32 random bytes, encode as base64, and keep this value stable in deployment secrets.
NOGITA_QUEUE_ENCRYPTION_KEY=
# Verified human IDs permitted to retrieve code and create tasks; comma separated
AUTHORIZED_ACTOR_IDS=demo-lead
# Compact JSON array linking trusted provider IDs to one internal ID.
# Keep real identifiers in local .env; see config/identities.example.json.
IDENTITY_MAP_JSON=[]

# Mode: demo (dependency-free and safe) or live (requires real credentials)
NOGITA_MODE=demo
BOARD_PROVIDER=demo
REPO_PROVIDER=demo
MEETING_PROVIDER=demo

# Jira Cloud (BOARD_PROVIDER=jira): per-project settings, no guessed assignees
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Jira account ID for the optional assignee, NEVER a guessed display name
JIRA_ASSIGNEE_ACCOUNT_ID=

# monday.com (BOARD_PROVIDER=monday)
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
# A valid Text column ID on that board; required to preserve issue descriptions
MONDAY_DESCRIPTION_COLUMN_ID=

# GitHub (REPO_PROVIDER=github)
# Public repositories can be read without a token only when this explicit gate is true.
GITHUB_PUBLIC_REPO=false
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_REF=main

# Recall.ai meeting bot (MEETING_PROVIDER=recall)
RECALL_API_KEY=
RECALL_REGION=us-east-1
# Voice is NOT yet connected. Recall join/chat works once configured.

# Attendee.dev (MEETING_PROVIDER=attendee). Do not enable before provider privacy review.
ATTENDEE_API_KEY=
ATTENDEE_PRIVACY_REVIEWED=false
ATTENDEE_WEBHOOK_URL=https://your-service.example/webhooks/attendee
# Base64-encoded project webhook secret from Attendee Settings > Webhooks.
ATTENDEE_WEBHOOK_SECRET=
# Used only for the local per-session cost estimate. Update if your Attendee plan has a different rate.
ATTENDEE_USD_PER_HOUR=0.50
# Signed transcript ingestion and stable Attendee identity mapping are supported.
# Realtime media is experimental and off by default; enable only after WSS,
# consent/privacy review, and a planned test meeting. The first TTS model is English-only.
NOGITA_REALTIME_AUDIO_ENABLED=false
ATTENDEE_AUDIO_WEBSOCKET_URL=wss://your-service.example/webhooks/attendee/audio
DEEPGRAM_API_KEY=
# Keep multilingual Nova-3 for Hebrew. flux-english is opt-in for English-only meetings.
DEEPGRAM_STT_MODE=nova3-multilingual
# English Aura-2 voice; change only after a consented listening comparison.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Update these local cost-estimate rates to match the active Deepgram plan.
DEEPGRAM_NOVA3_MULTILINGUAL_USD_PER_MINUTE=0.0058
DEEPGRAM_AURA2_USD_PER_THOUSAND_CHARACTERS=0.03

# Optional Anthropic reasoning for live text plans. ANTHROPIC_MODEL defaults to
# claude-haiku-5-5; override it only when intentionally choosing another model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_USD_PER_MILLION=0.10
ANTHROPIC_OUTPUT_USD_PER_MILLION=0.50
# Optional: a stronger model for multi-file why/architecture questions. Disabled when blank.
# At most 3 such calls per meeting by default; simple questions stay on ANTHROPIC_MODEL.
# Set prices to the actual model/account rates for usage estimates.
ANTHROPIC_CODE_REASONING_MODEL=
ANTHROPIC_CODE_INPUT_USD_PER_MILLION=3
ANTHROPIC_CODE_OUTPUT_USD_PER_MILLION=15
ANTHROPIC_MAX_CODE_REASONING_CALLS_PER_SESSION=3
# Conversational agent (live mode): answers every direct request with tools over GitHub, Jira and Slack,
# streams speech sentence by sentence and caches the prompt. NOGITA_AGENT=off falls back to the
# one-shot planner above. ANTHROPIC_AGENT_MODEL defaults to claude-haiku-5-5: in the voice lab it spoke its own
# words about 1.3 s sooner than claude-sonnet-5-5 with equal judged correctness. Use claude-sonnet-5-5
# (input 2, output 10 USD per million) for deeper code answers at higher latency.
NOGITA_AGENT=
ANTHROPIC_AGENT_MODEL=
ANTHROPIC_AGENT_INPUT_USD_PER_MILLION=0.10
ANTHROPIC_AGENT_OUTPUT_USD_PER_MILLION=0.50
# Speech recognition: flux-english was faster and more accurate than nova3-multilingual in every voice lab run.
# Extra Jira project keys the agent may read (comma-separated). Tasks are still created in JIRA_PROJECT_KEY.
JIRA_READ_PROJECT_KEYS=
# Where the platform has no native hand raise (Attendee today): 'chat' posts a short
# "Nogita has something to add" line; blank keeps the hand silent.
NOGITA_HAND_RAISE_FALLBACK=

# Slack signed Events API, if used
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Agent access to Slack needs bot scopes channels:read, groups:read, channels:history,
# groups:history, im:history, users:read and chat:write, plus the message.channels and
# message.groups events so replies in a thread Nogita is in reach her without a mention.
# Optional user token (xoxp-, search:read) enables message search across her channels.
SLACK_USER_TOKEN=

# Slack Socket Mode: create app-level token (connections:write) and bot token.
SLACK_APP_TOKEN=
SLACK_ALLOWED_TEAM_IDS=
# AUTHORIZED_ACTOR_IDS must include mapped internal IDs from IDENTITY_MAP_JSON.
