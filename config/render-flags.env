# Settings to add on Render when Roee decides to turn them on. No secrets belong in this file: keys and tokens go only
# in Render and in the local .env. The app does not read this file; nothing here is on until it is set on Render.
NOGITA_WRITE_INTENT=true
NOGITA_OFFER_APPROVAL=true
NOGITA_NOISY_TASK_REQUESTS=true
NOGITA_COMMENT_RETRY_GUARD=true
NOGITA_CI_STATUS=true
NOGITA_RESULT_DIGEST=true
NOGITA_EVIDENCE_LEDGER=true
NOGITA_PROOF_LEVELS=true
NOGITA_RESEARCH_TEMPLATES=true

# The v2 trial (P9-4, decided 2026-11-07): a controlled trial in the next meetings, not the default for everyone. Review
# the measurements in `npm run turn-report` before deciding (P5-9). The code default stays legacy.
NOGITA_TURN_TAKING_V2=true

# The value gate (P8-5) and its smoke check (P8-12).
NOGITA_LISTEN_FIRST=true
NOGITA_MEETING_RECAP=true
NOGITA_FOLLOW_UP=true
# NOGITA_ROOM_AWARE stays off: it is turned on only for its part of P8-12, and added here only if that part passes.
# Also set on Render: NOGITA_RECAP_CHANNEL, the Slack channel id that keeps the recaps. Unset: nothing is sent to Slack.
