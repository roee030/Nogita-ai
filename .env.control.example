# Nogita control plane (npm run control). Copy to .env.control locally; in deployment, set these as secrets.
# It is a separate service from the cells: it holds who each company is, its connections and keys (sealed), and
# starts one cell per company. It never sees meetings, code or tasks.

CONTROL_PUBLIC_URL=https://control.nogita.example
HOST=0.0.0.0
PORT=8788
# 32 random bytes, base64. Seals every company's keys and tokens; losing it loses them all. Keep it stable.
CONTROL_VAULT_KEY=
# At least 32 random characters. Signs sign-in sessions and OAuth state.
CONTROL_SESSION_SECRET=
# On a persistent disk in deployment.
CONTROL_STATE_DIR=.nogita-control

# ---- Sign-in (at least one) ----
# Google Cloud console > OAuth client (web). Redirect URI: <CONTROL_PUBLIC_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra > App registration, "Accounts in any organizational directory". Redirect URI:
# <CONTROL_PUBLIC_URL>/oauth/microsoft/callback. API permission: Microsoft Graph User.Read (delegated).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Slack: one distributed app for every company ----
# api.slack.com/apps > Manage Distribution on. OAuth redirect URL: <CONTROL_PUBLIC_URL>/oauth/slack/callback
# Bot scopes: app_mentions:read channels:read groups:read channels:history groups:history im:history users:read
#   users:read.email chat:write
# Event Subscriptions request URL: <CONTROL_PUBLIC_URL>/slack/events (events: app_mention, message.im,
#   app_uninstalled, tokens_revoked). The control plane passes each event to the company's cell.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Jira: Atlassian OAuth 2.0 (3LO) app ----
# developer.atlassian.com > Create > OAuth 2.0 integration, Distribution: sharing on.
# Permissions > Jira API: read:jira-work write:jira-work read:jira-user. Callback: <CONTROL_PUBLIC_URL>/oauth/atlassian/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ---- GitHub: a GitHub App (public) ----
# Repository permissions: Contents read-only, Metadata read-only. No webhook.
# Callback URL and Setup URL: <CONTROL_PUBLIC_URL>/oauth/github/callback, with "Request user authorization (OAuth)
# during installation" ON (it proves the installation belongs to the person who installed it).
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key (PEM). In one line, newlines written as \n.
GITHUB_APP_PRIVATE_KEY=

# ---- Cells on Render ----
# Without RENDER_API_KEY cells are only simulated in memory (local development).
RENDER_API_KEY=
# The workspace id (Account settings, or GET /v1/owners).
RENDER_OWNER_ID=
# The Nogita repository and branch every cell runs. Render must have access to it.
CELL_REPO=https://github.com/roee030/Nogita-ai
CELL_BRANCH=main
RENDER_PLAN=starter
RENDER_REGION=frankfurt
RENDER_DISK_GB=1
