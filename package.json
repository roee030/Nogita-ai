{
  "name": "nogita-v1-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policy-first, provider-independent virtual engineering teammate",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "demo": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/demo.ts",
    "start": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/app/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "slack": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/app/slack-socket.ts",
    "voice-lab": "node --disable-warning=ExperimentalWarning --experimental-transform-types tools/voice-lab/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@slack/socket-mode": "^2.0.4",
    "ws": "^8.22.0"
  }
}
